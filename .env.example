# Run scripts/local-env.sh for private local development credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/forma
DATABASE_USER=forma
DATABASE_PASSWORD=
JWT_SECRET=
EMS_DEMO_PASSWORD=
SPRING_PROFILES_ACTIVE=demo
# Production: omit the demo profile, supply bootstrap account securely.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional direct asset storage. AWS uses its normal credential provider chain.
S3_BUCKET=
AWS_REGION=us-east-1
