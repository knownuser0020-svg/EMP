{
  "name": "enterprise-ems",
  "version": "1.0.0",
  "private": true,
  "description": "Forma employee management workspace",
  "author": "Forma",
  "license": "UNLICENSED",
  "workspaces": [
    "ems-admin-client",
    "ems-employee-client",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w ems-admin-client",
    "dev:employee": "npm run dev -w ems-employee-client",
    "api": "bash scripts/start-api.sh",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/@playwright/test/cli.js test",
    "test:api": "cd ems-backend && ./mvnw test",
    "test:load": "node scripts/load-test.mjs",
    "desktop:admin": "node scripts/desktop.mjs admin",
    "desktop:employee": "node scripts/desktop.mjs employee",
    "package:admin": "node scripts/package-desktop.mjs admin",
    "package:employee": "node scripts/package-desktop.mjs employee"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.11",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
